{
  "name": "feishu-asset-floating-uploader",
  "version": "0.1.12",
  "description": "A floating Windows desktop uploader for Feishu Bitable creative assets.",
  "author": "方攀",
  "productName": "波利AI图助手",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist": "npm run build && electron-builder --win nsis && npm run prune:release",
    "pack": "npm run build && electron-builder --win dir",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "prune:release": "node scripts/prune-release.mjs"
  },
  "build": {
    "appId": "com.gamealestudio.asset-uploader",
    "productName": "波利AI图助手",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack-icon.cjs",
    "artifactName": "poring-gameale-${version}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/assets/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "publish": [
        {
          "provider": "github",
          "owner": "ggone-p",
          "repo": "poring-gameale",
          "releaseType": "release"
        }
      ],
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "波利AI图助手"
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.2.8",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
